config_version=5

[application]

config/name="雙子星玉米人"
config/version="0.1.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Tune="*res://core/tuning/tune.gd"
Audio="*res://core/audio/audio.gd"
InputSetup="*res://input_setup.gd"
GameState="*res://state/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[internationalization]

locale/include_text_server_data=true

[rendering]

environment/defaults/default_clear_color=Color(0.1, 0.12, 0.14, 1)
textures/vram_compression/import_etc2_astc=true
